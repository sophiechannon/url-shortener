{
  "name": "url-shortener",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @url-shortener/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "generate:openapi": "pnpm --filter @url-shortener/api generate:openapi",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
