{
  "name": "url-shortener-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/lambda.ts --bundle --platform=node --format=esm --target=node24 --minify --sourcemap --outfile=dist/index.mjs",
    "package": "pnpm build && cd dist && zip -q function.zip index.mjs index.mjs.map",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/aws-lambda": "^1.0.0",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@hono/node-server": "^2.1.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
